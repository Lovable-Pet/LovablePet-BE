# EC2 서버 ~/lovablepet-spring/.env 템플릿 — 실제 값은 서버에서만 만들고 커밋하지 않는다.
# 랜덤 값은 서버에서 openssl rand -hex 32 로 만든다. (JWT_SECRET 만 openssl rand -base64 32 — JwtProvider 가 Base64 로 디코딩)
# DB_URL, PET_PIPELINE_BASE_URL, PET_PIPELINE_CALLBACK_URL 은 docker-compose.yml 에 있다.

DB_NAME=lovablepet
DB_USERNAME=lovablepet
# DB 를 처음 띄울 때만 적용된다. 나중에 바꾸려면 DB 안에서도 ALTER USER 로 바꿔야 한다
DB_PASSWORD=

# ~/lovablepet-ai/.env 의 PIPELINE_API_KEY 와 같은 값
PET_PIPELINE_API_KEY=

JWT_SECRET=
TOKEN_HASH_SECRET=
ACCESS_TOKEN_EXPIRATION=1800000
REFRESH_TOKEN_EXPIRATION=1209600000

# 공공데이터포털 일반 인증키(Decoding) — 구조동물 조회 서비스. 비워 두면 동물 동기화만 동작하지 않는다
DATA_GO_KR_SERVICE_KEY=

# 비워 두면 카카오 로그인만 동작하지 않는다 (줄 자체는 있어야 한다)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=

# 쉼표 구분
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
