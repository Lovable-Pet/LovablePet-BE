# application-local.yml 템플릿 (이 파일은 커밋됨)
# 사용법: cp application-local.yml.example application-local.yml
# 개인 로컬 환경에 맞게 값을 바꿔 쓰면 된다. application-local.yml 은 .gitignore 대상이다.
spring:
  jpa:
    show-sql: true
    properties:
      hibernate:
        format_sql: true

logging:
  level:
    com.lovablepet: DEBUG
    org.hibernate.SQL: DEBUG
