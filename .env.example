# 환경변수 템플릿 — 복사해서 .env 로 사용 (.env 는 커밋 금지)
#   cp .env.example .env
# docker compose 는 .env 를 자동으로 읽는다.
# ./gradlew bootRun 은 .env 를 읽지 않으므로, 기본값과 다르게 쓰려면 셸/IDE 실행 설정에 환경변수를 지정할 것.

SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# Database
DB_NAME=lovablepet
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/lovablepet
DB_USERNAME=lovablepet
DB_PASSWORD=lovablepet

# Python 3D 생성(AI) 서버
PETGEN_BASE_URL=http://localhost:8000
PETGEN_TOKEN=local-dev-token
PETGEN_CALLBACK_URL=http://localhost:8080/api/generation/webhook
PETGEN_CONNECT_TIMEOUT=5s
PETGEN_READ_TIMEOUT=30s

# Storage
STORAGE_ROOT=./storage

# CORS (쉼표 구분)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Kakao OAuth
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=

# Auth (JWT)
# 로컬은 주석 그대로 두면 application.yml 의 개발용 기본값을 쓴다. (빈 값으로 지정하면 기동 실패)
# 운영(prod)에서는 반드시 지정 — 예: openssl rand -base64 32
# JWT_SECRET=
# TOKEN_HASH_SECRET=
# ACCESS_TOKEN_EXPIRATION=1800000
# REFRESH_TOKEN_EXPIRATION=1209600000
